{
  "name": "code-colorful-recent-files",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.3.0",
  "publisher": "edwardsayer",
  "repository": {
    "type": "git",
    "url": "https://github.com/edwardsayer/code-colorful-recent-files.git"
  },
  "homepage": "https://github.com/edwardsayer/code-colorful-recent-files#readme",
  "bugs": {
    "url": "https://github.com/edwardsayer/code-colorful-recent-files/issues"
  },
  "icon": "assets/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "recent files",
    "history",
    "mru",
    "explorer",
    "decoration",
    "rainbow",
    "vertical tabs",
    "open tabs",
    "tab sidebar"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "colors": [
      {
        "id": "colorfulRecentFiles.heat1",
        "description": "%colorfulRecentFiles.color.heat1%",
        "defaults": {
          "dark": "#EF8773",
          "light": "#AD0707",
          "highContrast": "#EF8773",
          "highContrastLight": "#AD0707"
        }
      },
      {
        "id": "colorfulRecentFiles.heat2",
        "description": "%colorfulRecentFiles.color.heat2%",
        "defaults": {
          "dark": "#CD861A",
          "light": "#D18616",
          "highContrast": "#CD861A",
          "highContrastLight": "#D18616"
        }
      },
      {
        "id": "colorfulRecentFiles.heat3",
        "description": "%colorfulRecentFiles.color.heat3%",
        "defaults": {
          "dark": "#E0B97F",
          "light": "#667309",
          "highContrast": "#E0B97F",
          "highContrastLight": "#667309"
        }
      },
      {
        "id": "colorfulRecentFiles.heat4",
        "description": "%colorfulRecentFiles.color.heat4%",
        "defaults": {
          "dark": "#86CF86",
          "light": "#388A34",
          "highContrast": "#86CF86",
          "highContrastLight": "#388A34"
        }
      },
      {
        "id": "colorfulRecentFiles.heat5",
        "description": "%colorfulRecentFiles.color.heat5%",
        "defaults": {
          "dark": "#57A3F8",
          "light": "#1A5CFF",
          "highContrast": "#57A3F8",
          "highContrastLight": "#1A5CFF"
        }
      },
      {
        "id": "colorfulRecentFiles.heat6",
        "description": "%colorfulRecentFiles.color.heat6%",
        "defaults": {
          "dark": "#AD80D7",
          "light": "#652D90",
          "highContrast": "#AD80D7",
          "highContrastLight": "#652D90"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-colorful-recent-files",
          "title": "%container.title%",
          "icon": "assets/clockface.svg"
        }
      ]
    },
    "views": {
      "code-colorful-recent-files": [
        {
          "id": "codeColorfulRecentFiles.recentView",
          "name": "%view.recentView.name%",
          "contextualTitle": "%container.title%"
        }
      ]
    },
    "commands": [
      {
        "command": "codeColorfulRecentFiles.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.clearHistory",
        "title": "%command.clearHistory.title%",
        "icon": "$(clear-all)",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.removeItem",
        "title": "%command.removeItem.title%",
        "icon": "$(close)",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.openFile",
        "title": "%command.openFile.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.cycleGroupByNone",
        "title": "%menu.groupBy.None%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.cycleGroupByType",
        "title": "%menu.groupBy.Type%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.cycleGroupByDirectory",
        "title": "%menu.groupBy.Directory%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.cycleColorSchemeRank",
        "title": "%menu.colorScheme.Rank%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.cycleColorSchemeBucket",
        "title": "%menu.colorScheme.Bucket%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.cycleColorSchemePlainText",
        "title": "%menu.colorScheme.PlainText%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.cycleHighlightModeAccess",
        "title": "%menu.timeMetric.Access%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.cycleHighlightModeModified",
        "title": "%menu.timeMetric.Modified%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleSyncWithOpenTabsOn",
        "title": "%menu.syncWithOpenTabs.off%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleSyncWithOpenTabsOff",
        "title": "%menu.syncWithOpenTabs.on%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleShowColorDotIconOn",
        "title": "%menu.showColorDotIcon.off%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleShowColorDotIconOff",
        "title": "%menu.showColorDotIcon.on%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleStyleNativeExplorerOn",
        "title": "%menu.styleNativeExplorer.off%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleStyleNativeExplorerOff",
        "title": "%menu.styleNativeExplorer.on%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.openToSide",
        "title": "%command.openToSide.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.closeTab",
        "title": "%command.closeTab.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.closeOthers",
        "title": "%command.closeOthers.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.closeSaved",
        "title": "%command.closeSaved.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.closeAll",
        "title": "%command.closeAll.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.togglePin",
        "title": "%command.togglePin.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.splitRight",
        "title": "%command.splitRight.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.splitDown",
        "title": "%command.splitDown.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.moveToNewWindow",
        "title": "%command.moveToNewWindow.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.copyPath",
        "title": "%command.copyPath.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.copyRelativePath",
        "title": "%command.copyRelativePath.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.revealInExplorer",
        "title": "%command.revealInExplorer.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.revealInOS",
        "title": "%command.revealInOS.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.openInTerminal",
        "title": "%command.openInTerminal.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.findInFolder",
        "title": "%command.findInFolder.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.closeGroup",
        "title": "%command.closeGroup.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.removeGroup",
        "title": "%command.removeGroup.title%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.pinGroup",
        "title": "%command.pinGroup.title%",
        "icon": "$(pin)",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.unpinGroup",
        "title": "%command.unpinGroup.title%",
        "icon": "$(pinned)",
        "category": "%category.recentFiles%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeColorfulRecentFiles.refresh",
          "when": "view == codeColorfulRecentFiles.recentView",
          "group": "navigation"
        },
        {
          "command": "codeColorfulRecentFiles.cycleGroupByNone",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.groupBy == 'none'",
          "group": "1_options@1"
        },
        {
          "command": "codeColorfulRecentFiles.cycleGroupByType",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.groupBy == 'type'",
          "group": "1_options@1"
        },
        {
          "command": "codeColorfulRecentFiles.cycleGroupByDirectory",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.groupBy == 'directory'",
          "group": "1_options@1"
        },
        {
          "command": "codeColorfulRecentFiles.cycleColorSchemeRank",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.colorScheme == 'rankSpectrum'",
          "group": "1_options@4"
        },
        {
          "command": "codeColorfulRecentFiles.cycleColorSchemeBucket",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.colorScheme == 'timeBucket'",
          "group": "1_options@4"
        },
        {
          "command": "codeColorfulRecentFiles.cycleColorSchemePlainText",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.colorScheme == 'plainText'",
          "group": "1_options@4"
        },
        {
          "command": "codeColorfulRecentFiles.cycleHighlightModeAccess",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.highlightMode == 'lastAccess'",
          "group": "1_options@7"
        },
        {
          "command": "codeColorfulRecentFiles.cycleHighlightModeModified",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.highlightMode == 'lastModified'",
          "group": "1_options@7"
        },
        {
          "command": "codeColorfulRecentFiles.toggleSyncWithOpenTabsOn",
          "when": "view == codeColorfulRecentFiles.recentView && !config.codeColorfulRecentFiles.syncWithOpenTabs",
          "group": "1_options@3"
        },
        {
          "command": "codeColorfulRecentFiles.toggleSyncWithOpenTabsOff",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.syncWithOpenTabs",
          "group": "1_options@3"
        },
        {
          "command": "codeColorfulRecentFiles.toggleShowColorDotIconOn",
          "when": "view == codeColorfulRecentFiles.recentView && !config.codeColorfulRecentFiles.showColorDotIcon",
          "group": "1_options@5"
        },
        {
          "command": "codeColorfulRecentFiles.toggleShowColorDotIconOff",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.showColorDotIcon",
          "group": "1_options@5"
        },
        {
          "command": "codeColorfulRecentFiles.toggleStyleNativeExplorerOn",
          "when": "view == codeColorfulRecentFiles.recentView && !config.codeColorfulRecentFiles.styleNativeExplorer",
          "group": "1_options@6"
        },
        {
          "command": "codeColorfulRecentFiles.toggleStyleNativeExplorerOff",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.styleNativeExplorer",
          "group": "1_options@6"
        },
        {
          "command": "codeColorfulRecentFiles.clearHistory",
          "when": "view == codeColorfulRecentFiles.recentView",
          "group": "2_manage@1"
        }
      ],
      "view/item/context": [
        {
          "command": "codeColorfulRecentFiles.pinGroup",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^(folderItem|typeItem)$/",
          "group": "inline@1"
        },
        {
          "command": "codeColorfulRecentFiles.unpinGroup",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^(folderItem|typeItem)\\.pinned$/",
          "group": "inline@1"
        },
        {
          "command": "codeColorfulRecentFiles.removeItem",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^fileItem/",
          "group": "inline"
        },
        {
          "command": "codeColorfulRecentFiles.closeTab",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem == fileItem.tab",
          "group": "1_close@1"
        },
        {
          "command": "codeColorfulRecentFiles.closeOthers",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem == fileItem.tab",
          "group": "1_close@2"
        },
        {
          "command": "codeColorfulRecentFiles.closeSaved",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem == fileItem.tab",
          "group": "1_close@3"
        },
        {
          "command": "codeColorfulRecentFiles.closeAll",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem == fileItem.tab",
          "group": "1_close@4"
        },
        {
          "command": "codeColorfulRecentFiles.togglePin",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem == fileItem.tab",
          "group": "2_pin@1"
        },
        {
          "command": "codeColorfulRecentFiles.openToSide",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^fileItem/",
          "group": "3_split@1"
        },
        {
          "command": "codeColorfulRecentFiles.splitRight",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem == fileItem.tab",
          "group": "3_split@2"
        },
        {
          "command": "codeColorfulRecentFiles.splitDown",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem == fileItem.tab",
          "group": "3_split@3"
        },
        {
          "command": "codeColorfulRecentFiles.moveToNewWindow",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem == fileItem.tab",
          "group": "3_split@4"
        },
        {
          "command": "codeColorfulRecentFiles.closeGroup",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^(folderItem|typeItem)(\\.pinned)?$/ && config.codeColorfulRecentFiles.syncWithOpenTabs",
          "group": "1_close@1"
        },
        {
          "command": "codeColorfulRecentFiles.removeGroup",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^(folderItem|typeItem)(\\.pinned)?$/ && !config.codeColorfulRecentFiles.syncWithOpenTabs",
          "group": "4_history@1"
        },
        {
          "command": "codeColorfulRecentFiles.removeItem",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^fileItem/ && !config.codeColorfulRecentFiles.syncWithOpenTabs",
          "group": "4_history@1"
        },
        {
          "command": "codeColorfulRecentFiles.revealInExplorer",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^(fileItem|folderItem)/",
          "group": "5_reveal@1"
        },
        {
          "command": "codeColorfulRecentFiles.revealInOS",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^(fileItem|folderItem)/",
          "group": "5_reveal@2"
        },
        {
          "command": "codeColorfulRecentFiles.openInTerminal",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^folderItem(\\.pinned)?$/ && !config.codeColorfulRecentFiles.syncWithOpenTabs",
          "group": "5_reveal@3"
        },
        {
          "command": "codeColorfulRecentFiles.findInFolder",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^folderItem(\\.pinned)?$/ && !config.codeColorfulRecentFiles.syncWithOpenTabs",
          "group": "5_reveal@4"
        },
        {
          "command": "codeColorfulRecentFiles.copyPath",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^(fileItem|folderItem)/",
          "group": "6_copy@1"
        },
        {
          "command": "codeColorfulRecentFiles.copyRelativePath",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem =~ /^(fileItem|folderItem)/",
          "group": "6_copy@2"
        }
      ],
      "commandPalette": [
        {
          "command": "codeColorfulRecentFiles.openToSide",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.closeTab",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.closeOthers",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.closeSaved",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.closeAll",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.togglePin",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.splitRight",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.splitDown",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.moveToNewWindow",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.copyPath",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.copyRelativePath",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.revealInExplorer",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.revealInOS",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.openInTerminal",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.findInFolder",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.closeGroup",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.removeGroup",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.pinGroup",
          "when": "false"
        },
        {
          "command": "codeColorfulRecentFiles.unpinGroup",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codeColorfulRecentFiles.groupBy": {
          "type": "string",
          "enum": [
            "none",
            "directory",
            "type"
          ],
          "default": "none",
          "description": "%configuration.groupBy.description%"
        },
        "codeColorfulRecentFiles.syncWithOpenTabs": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.syncWithOpenTabs.description%"
        },
        "codeColorfulRecentFiles.groupByDirectory": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.groupByDirectory.description%"
        },
        "codeColorfulRecentFiles.colorScheme": {
          "type": "string",
          "enum": [
            "rankSpectrum",
            "timeBucket",
            "plainText"
          ],
          "default": "rankSpectrum",
          "description": "%configuration.colorScheme.description%"
        },
        "codeColorfulRecentFiles.showColorDotIcon": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.showColorDotIcon.description%"
        },
        "codeColorfulRecentFiles.styleNativeExplorer": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.styleNativeExplorer.description%"
        },
        "codeColorfulRecentFiles.maxRecentFiles": {
          "type": "integer",
          "default": 50,
          "minimum": 5,
          "maximum": 500,
          "description": "%configuration.maxRecentFiles.description%"
        },
        "codeColorfulRecentFiles.highlightMode": {
          "type": "string",
          "enum": [
            "lastAccess",
            "lastModified"
          ],
          "default": "lastAccess",
          "description": "%configuration.highlightMode.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "package:vsix": "node esbuild.mjs --production && vsce package",
    "check:project": "node scripts/check-project.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run check:project"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

{
  "name": "code-colorful-recent-files",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "edwardsayer",
  "icon": "assets/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "recent files",
    "history",
    "mru",
    "explorer",
    "decoration",
    "rainbow"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "colors": [
      {
        "id": "colorfulRecentFiles.heat1",
        "description": "%colorfulRecentFiles.color.heat1%",
        "defaults": {
          "dark": "charts.red",
          "light": "charts.red",
          "highContrast": "charts.red"
        }
      },
      {
        "id": "colorfulRecentFiles.heat2",
        "description": "%colorfulRecentFiles.color.heat2%",
        "defaults": {
          "dark": "charts.orange",
          "light": "charts.orange",
          "highContrast": "charts.orange"
        }
      },
      {
        "id": "colorfulRecentFiles.heat3",
        "description": "%colorfulRecentFiles.color.heat3%",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow"
        }
      },
      {
        "id": "colorfulRecentFiles.heat4",
        "description": "%colorfulRecentFiles.color.heat4%",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green"
        }
      },
      {
        "id": "colorfulRecentFiles.heat5",
        "description": "%colorfulRecentFiles.color.heat5%",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue"
        }
      },
      {
        "id": "colorfulRecentFiles.heat6",
        "description": "%colorfulRecentFiles.color.heat6%",
        "defaults": {
          "dark": "charts.purple",
          "light": "charts.purple",
          "highContrast": "charts.purple"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-colorful-recent-files",
          "title": "%container.title%",
          "icon": "assets/clockface.svg"
        }
      ]
    },
    "views": {
      "code-colorful-recent-files": [
        {
          "id": "codeColorfulRecentFiles.recentView",
          "name": "%view.recentView.name%",
          "contextualTitle": "%container.title%"
        }
      ]
    },
    "commands": [
      {
        "command": "codeColorfulRecentFiles.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.setGroupByNone",
        "title": "%command.groupBy.none%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.setGroupByDirectory",
        "title": "%command.groupBy.directory%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.setGroupByType",
        "title": "%command.groupBy.type%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleSyncWithOpenTabsOn",
        "title": "%command.syncWithOpenTabs.off%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleSyncWithOpenTabsOff",
        "title": "%command.syncWithOpenTabs.on%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.setFolderSortLatest",
        "title": "%command.folderSort.latest%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.setFolderSortName",
        "title": "%command.folderSort.name%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.setFolderSortManual",
        "title": "%command.folderSort.manual%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleGroupByDirectoryOn",
        "title": "%command.toggleGroupByDirectory.on%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleGroupByDirectoryOff",
        "title": "%command.toggleGroupByDirectory.off%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleColorSchemeRank",
        "title": "%command.colorScheme.rank%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleColorSchemeBucket",
        "title": "%command.colorScheme.bucket%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleShowColorDotIconOn",
        "title": "%command.showColorDotIcon.off%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleShowColorDotIconOff",
        "title": "%command.showColorDotIcon.on%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleStyleNativeExplorerOn",
        "title": "%command.styleNativeExplorer.on%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleStyleNativeExplorerOff",
        "title": "%command.styleNativeExplorer.off%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleHighlightModeToModified",
        "title": "%command.highlightMode.toModified%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.toggleHighlightModeToAccess",
        "title": "%command.highlightMode.toAccess%",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.clearHistory",
        "title": "%command.clearHistory.title%",
        "icon": "$(clear-all)",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.removeItem",
        "title": "%command.removeItem.title%",
        "icon": "$(close)",
        "category": "%category.recentFiles%"
      },
      {
        "command": "codeColorfulRecentFiles.openFile",
        "title": "%command.openFile.title%",
        "category": "%category.recentFiles%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeColorfulRecentFiles.refresh",
          "when": "view == codeColorfulRecentFiles.recentView",
          "group": "navigation"
        },
        {
          "command": "codeColorfulRecentFiles.setGroupByDirectory",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.groupBy == 'none'",
          "group": "1_options@1"
        },
        {
          "command": "codeColorfulRecentFiles.setGroupByType",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.groupBy == 'directory'",
          "group": "1_options@1"
        },
        {
          "command": "codeColorfulRecentFiles.setGroupByNone",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.groupBy == 'type'",
          "group": "1_options@1"
        },
        {
          "command": "codeColorfulRecentFiles.setFolderSortName",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.groupBy != 'none' && config.codeColorfulRecentFiles.folderSortOrder == 'latest'",
          "group": "1_options@2"
        },
        {
          "command": "codeColorfulRecentFiles.setFolderSortManual",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.groupBy != 'none' && config.codeColorfulRecentFiles.folderSortOrder == 'name'",
          "group": "1_options@2"
        },
        {
          "command": "codeColorfulRecentFiles.setFolderSortLatest",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.groupBy != 'none' && config.codeColorfulRecentFiles.folderSortOrder == 'manual'",
          "group": "1_options@2"
        },
        {
          "command": "codeColorfulRecentFiles.toggleSyncWithOpenTabsOff",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.syncWithOpenTabs",
          "group": "1_options@3"
        },
        {
          "command": "codeColorfulRecentFiles.toggleSyncWithOpenTabsOn",
          "when": "view == codeColorfulRecentFiles.recentView && !config.codeColorfulRecentFiles.syncWithOpenTabs",
          "group": "1_options@3"
        },
        {
          "command": "codeColorfulRecentFiles.toggleColorSchemeRank",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.colorScheme == 'rankSpectrum'",
          "group": "1_options@4"
        },
        {
          "command": "codeColorfulRecentFiles.toggleColorSchemeBucket",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.colorScheme != 'rankSpectrum'",
          "group": "1_options@4"
        },
        {
          "command": "codeColorfulRecentFiles.toggleShowColorDotIconOff",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.showColorDotIcon",
          "group": "1_options@5"
        },
        {
          "command": "codeColorfulRecentFiles.toggleShowColorDotIconOn",
          "when": "view == codeColorfulRecentFiles.recentView && !config.codeColorfulRecentFiles.showColorDotIcon",
          "group": "1_options@5"
        },
        {
          "command": "codeColorfulRecentFiles.toggleStyleNativeExplorerOff",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.styleNativeExplorer",
          "group": "1_options@6"
        },
        {
          "command": "codeColorfulRecentFiles.toggleStyleNativeExplorerOn",
          "when": "view == codeColorfulRecentFiles.recentView && !config.codeColorfulRecentFiles.styleNativeExplorer",
          "group": "1_options@6"
        },
        {
          "command": "codeColorfulRecentFiles.toggleHighlightModeToModified",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.highlightMode == 'lastAccess'",
          "group": "1_options@7"
        },
        {
          "command": "codeColorfulRecentFiles.toggleHighlightModeToAccess",
          "when": "view == codeColorfulRecentFiles.recentView && config.codeColorfulRecentFiles.highlightMode != 'lastAccess'",
          "group": "1_options@7"
        },
        {
          "command": "codeColorfulRecentFiles.clearHistory",
          "when": "view == codeColorfulRecentFiles.recentView",
          "group": "2_manage@1"
        }
      ],
      "view/item/context": [
        {
          "command": "codeColorfulRecentFiles.removeItem",
          "when": "view == codeColorfulRecentFiles.recentView && viewItem == fileItem",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codeColorfulRecentFiles.groupBy": {
          "type": "string",
          "enum": [
            "none",
            "directory",
            "type"
          ],
          "default": "none",
          "description": "%configuration.groupBy.description%"
        },
        "codeColorfulRecentFiles.folderSortOrder": {
          "type": "string",
          "enum": [
            "latest",
            "name",
            "manual"
          ],
          "default": "latest",
          "description": "%configuration.folderSortOrder.description%"
        },
        "codeColorfulRecentFiles.syncWithOpenTabs": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.syncWithOpenTabs.description%"
        },
        "codeColorfulRecentFiles.groupByDirectory": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.groupByDirectory.description%"
        },
        "codeColorfulRecentFiles.colorScheme": {
          "type": "string",
          "enum": [
            "rankSpectrum",
            "timeBucket"
          ],
          "default": "rankSpectrum",
          "description": "%configuration.colorScheme.description%"
        },
        "codeColorfulRecentFiles.showColorDotIcon": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.showColorDotIcon.description%"
        },
        "codeColorfulRecentFiles.styleNativeExplorer": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.styleNativeExplorer.description%"
        },
        "codeColorfulRecentFiles.maxRecentFiles": {
          "type": "integer",
          "default": 50,
          "minimum": 5,
          "maximum": 500,
          "description": "%configuration.maxRecentFiles.description%"
        },
        "codeColorfulRecentFiles.highlightMode": {
          "type": "string",
          "enum": [
            "lastAccess",
            "lastModified"
          ],
          "default": "lastAccess",
          "description": "%configuration.highlightMode.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "package:vsix": "node esbuild.mjs --production && vsce package --no-rewrite-relative-links --allow-missing-repository",
    "check:project": "node scripts/check-project.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run check:project"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
